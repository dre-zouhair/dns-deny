FROM golang:1.27.3 AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /mock-upstream ./cmd/mock-upstream

FROM scratch
COPY --from=builder /mock-upstream /mock-upstream
EXPOSE 53/udp 53/tcp 5353/udp 5353/tcp
ENTRYPOINT ["/mock-upstream"]
